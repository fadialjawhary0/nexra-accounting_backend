# Copy to .env and fill in. The server validates these at boot (src/lib/config/env.validation.ts) — a missing value stops it with a clear message.

NODE_ENV=development
PORT=4000

# PostgreSQL on this machine. Replace the password with the one you chose for the "postgres" user; encode special characters (/ becomes %2F, @ becomes %40).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nexra?schema=public

# The Next.js app (used in links inside e-mails).
FRONTEND_URL=http://localhost:3000
# Proxies in front of the API: 0 locally, 1 behind Vercel → Render. Sign-in lockout and rate limits work per IP address, so this must be right in production.
TRUST_PROXY_HOPS=0

# Signs the access tokens: a random string of at least 32 characters.  openssl rand -base64 48
# (Session lengths, lockout and rate limits are not here — Ahmad changes them in Settings → Security.)
JWT_ACCESS_SECRET=

# Cookies. In production: COOKIE_SECURE=true and COOKIE_DOMAIN=.nexrabv.nl (or leave empty for the exact host).
# COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Uploaded files (local disk).
STORAGE_DIR=./storage

# E-mail (invitations and password resets). Leave SMTP_HOST out in development: mails are written to the backend log instead of being sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Nexra B.V. <no-reply@nexrabv.nl>"

# Encrypts 2FA secrets and restricted personal data (BSN, IBAN). 32 random bytes in base64:  openssl rand -base64 32
# Losing this key makes the encrypted values unreadable — keep a copy somewhere safe.
ENCRYPTION_KEY=

# First owner account, created by `npm run db:seed` (only when this e-mail address does not exist yet).
# The password must be changed at the first sign-in. Use a real address in production (e.g. Ahmad's) and a temporary password.
# SEED_OWNER_EMAIL=
# SEED_OWNER_NAME=
# SEED_OWNER_PASSWORD=

# Later phases:
# OPENAI_API_KEY=
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
